def normalize_rows(X, eps=1e-12):
    norms = np.linalg.norm(X, axis=1, keepdims=True)
    return X / np.maximum(norms, eps)


def load_components(path, n_pcs):
    X = np.load(path)
    if X.ndim != 2:
        raise ValueError(f"Expected PCA components [n_pcs, n_features], got {X.shape}")

    n_pcs = min(n_pcs, X.shape[0])
    return X[:n_pcs].astype(np.float64)


def compute_basis_cosine(layer8_components, all_layer_components):
    """
    Returns signed cosine similarity:

      sim[i, j] = cosine(all-layer PC i, layer8-only PC j)

    Shape:
      [n_all_layer_pcs, n_layer8_pcs]
    """
    A = normalize_rows(all_layer_components)
    B = normalize_rows(layer8_components)
    return A @ B.T


def plot_heatmap(sim, output_path, title, use_abs=False):
    data = np.abs(sim) if use_abs else sim

    vmin, vmax = (0, 1) if use_abs else (-1, 1)
    cmap = "viridis" if use_abs else "coolwarm"

    plt.figure(figsize=(12, 7))
    im = plt.imshow(data, vmin=vmin, vmax=vmax, cmap=cmap, aspect="auto")

    plt.yticks(
        np.arange(data.shape[0]),
        [f"All-layer PC{i}" for i in range(1, data.shape[0] + 1)],
    )
    plt.xticks(
        np.arange(data.shape[1]),
        [f"Layer8 PC{i}" for i in range(1, data.shape[1] + 1)],
        rotation=90,
    )

    plt.colorbar(im, label="Absolute cosine similarity" if use_abs else "Signed cosine similarity")
    plt.title(title)
    plt.xlabel("Layer8-only PCA basis")
    plt.ylabel("All-layer PCA basis")

    match_scores = np.abs(sim)
    for i in range(match_scores.shape[0]):
        best_j = int(np.nanargmax(match_scores[i]))
        plt.text(
            best_j,
            i,
            "*",
            ha="center",
            va="center",
            color="white" if use_abs else "black",
            fontsize=16,
            fontweight="bold",
        )

    plt.tight_layout()
    plt.savefig(output_path, dpi=300, bbox_inches="tight")
    plt.close()
    print(f"Saved {output_path}")


def plot_best_match_bars(sim, output_path):
    abs_sim = np.abs(sim)
    best_j = np.nanargmax(abs_sim, axis=1)
    best_abs = abs_sim[np.arange(abs_sim.shape[0]), best_j]
    best_signed = sim[np.arange(sim.shape[0]), best_j]

    labels = [f"All PC{i+1}\n-> L8 PC{best_j[i]+1}" for i in range(len(best_j))]
    colors = ["tab:red" if s < 0 else "tab:blue" for s in best_signed]

    plt.figure(figsize=(14, 5))
    x = np.arange(len(labels))
    plt.bar(x, best_abs, color=colors)

    plt.xticks(x, labels, rotation=90)
    plt.ylabel("Best absolute basis cosine")
    plt.ylim(0, 1.05)
    plt.title("Best PCA-basis matches; red means sign-flipped match")

    for i, signed_score in enumerate(best_signed):
        plt.text(
            i,
            best_abs[i] + 0.02,
            f"{signed_score:+.2f}",
            ha="center",
            va="bottom",
            fontsize=8,
        )

    plt.tight_layout()
    plt.savefig(output_path, dpi=300, bbox_inches="tight")
    plt.close()
    print(f"Saved {output_path}")


def save_match_table(sim, output_path):
    abs_sim = np.abs(sim)
    best_j = np.nanargmax(abs_sim, axis=1)

    with open(output_path, "w") as f:
        f.write("all_layer_pc,best_layer8_pc,signed_cosine,abs_cosine,sign_relation\n")

        for i, j in enumerate(best_j):
            signed = float(sim[i, j])
            abs_val = abs(signed)
            sign_relation = "same_sign" if signed >= 0 else "flipped_sign"

            f.write(
                f"PC{i+1},PC{j+1},{signed:.6f},{abs_val:.6f},{sign_relation}\n"
            )

    print(f"Saved {output_path}")


def load_activation_matrix(path: Path) -> np.ndarray:
    x = np.load(path, mmap_mode="r")

    if x.dtype == np.dtype("|V2"):
        x = x.view(np.float16)

    x = np.asarray(x, dtype=np.float32)

    if x.ndim == 3 and x.shape[1] == 1:
        x = x[:, 0, :]

    x = np.squeeze(x)

    if x.ndim != 2:
        raise ValueError(f"Expected [nodes, features], got {x.shape} for {path.name}")

    return x


def vertices_to_latlon(vertices: np.ndarray):
    lat = np.degrees(np.arcsin(vertices[:, 2]))
    lon = np.degrees(np.arctan2(vertices[:, 1], vertices[:, 0]))
    return lat, lon


def get_mesh_latlon(splits: int = 6):
    meshes = icosahedral_mesh.get_hierarchy_of_triangular_meshes_for_sphere(splits=splits)
    vertices = meshes[splits].vertices
    return vertices_to_latlon(vertices)


def plot_pc_map(scores, lat, lon, out_path, title):
    vmax = np.nanpercentile(np.abs(scores), 99)
    vmax = max(vmax, 1e-6)

    plt.figure(figsize=(12, 6))
    sc = plt.scatter(
        lon,
        lat,
        c=scores,
        s=2,
        cmap="coolwarm",
        vmin=-vmax,
        vmax=vmax,
        linewidths=0,
    )
    plt.colorbar(sc, label="PC score")
    plt.xlabel("Longitude")
    plt.ylabel("Latitude")
    plt.title(title)
    plt.tight_layout()
    plt.savefig(out_path, dpi=300, bbox_inches="tight")
    plt.close()


def signed_same_index_cosines(components_a, components_b):
    A = normalize_rows(components_a)
    B = normalize_rows(components_b)
    return np.sum(A * B, axis=1)


def full_basis_cosine_matrix(components_a, components_b):
    A = normalize_rows(components_a)
    B = normalize_rows(components_b)
    return A @ B.T


