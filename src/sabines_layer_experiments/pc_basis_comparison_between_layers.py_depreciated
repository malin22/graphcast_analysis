def plot_layer0_8_15_overview(layer_mean_scores, lat, lon):
    components = {
        layer: np.load(LAYER_PCA_COMPONENTS[layer])[:N_LAYER_COMPARE_PCS].astype(np.float64)
        for layer in LAYERS_TO_COMPARE
    }

    cos_0_8 = signed_same_index_cosines(components[0], components[8])
    cos_8_15 = signed_same_index_cosines(components[8], components[15])
    cos_0_15 = signed_same_index_cosines(components[0], components[15])

    all_vals = np.concatenate([
        layer_mean_scores[layer][:, :N_LAYER_COMPARE_PCS].ravel()
        for layer in LAYERS_TO_COMPARE
    ])
    vmax = np.nanpercentile(np.abs(all_vals), 99)
    vmax = max(vmax, 1e-6)

    fig, axes = plt.subplots(
        nrows=N_LAYER_COMPARE_PCS,
        ncols=3,
        figsize=(15, 3.0 * N_LAYER_COMPARE_PCS),
        sharex=True,
        sharey=True,
    )

    for row in range(N_LAYER_COMPARE_PCS):
        pc = row + 1

        for col, layer in enumerate(LAYERS_TO_COMPARE):
            ax = axes[row, col]
            scores = layer_mean_scores[layer][:, row]

            sc = ax.scatter(
                lon,
                lat,
                c=scores,
                s=1,
                cmap="coolwarm",
                vmin=-vmax,
                vmax=vmax,
                linewidths=0,
            )

            ax.set_xticks([])
            ax.set_yticks([])

            if row == 0:
                ax.set_title(f"Layer {layer}", fontsize=13)

        axes[row, 0].set_ylabel(
            (
                f"PC{pc}\n"
                f"L0-L8 {cos_0_8[row]:+.2f}\n"
                f"L8-L15 {cos_8_15[row]:+.2f}\n"
                f"L0-L15 {cos_0_15[row]:+.2f}"
            ),
            fontsize=9,
            rotation=0,
            labelpad=55,
            va="center",
        )

    fig.suptitle(
        "January mean PC maps from independently fitted layer PCAs",
        fontsize=16,
        y=0.995,
    )

    cbar = fig.colorbar(sc, ax=axes.ravel().tolist(), shrink=0.6)
    cbar.set_label("PC score")

    out = LAYER_COMPARE_OUT_DIR / "layer0_8_15_top15_mean_pc_maps.png"
    plt.savefig(out, dpi=250, bbox_inches="tight")
    plt.close()
    print(f"Saved {out}")


